# Deployment is fail-closed. These flags are NOT activated by source publication.
FSP_REAL_ACCOUNTS_ENABLED=false
FSP_EMAIL_MODE=off
# Set only after the data operator has approved a real policy and retention plan.
FSP_PRIVACY_NOTICE_URL=
FSP_PRIVACY_NOTICE_VERSION=
# Configure an owned verified sending subdomain after explicit approval.
FSP_EMAIL_FROM=
FSP_SITE_ORIGIN=https://axiom-fsp-talent.major-tick-1728.chatgpt.site
# Supply through a secure runtime-secret workflow; never put real values in Git.
FSP_EMAIL_TOKEN_SECRET=
RESEND_API_KEY=
# Resend stays the default. Source publication does not enable either transport.
FSP_EMAIL_TRANSPORT=resend
# Optional Google MailApp pilot, configured only after separate owner approval.
FSP_GOOGLE_RELAY_URL=
FSP_GOOGLE_RELAY_AUDIENCE=
FSP_GOOGLE_RELAY_SECRET=

# Optional owner-only diagnostic; never enabled by source publication.
FSP_OWNER_EMAIL_TEST_ENABLED=false
FSP_OWNER_EMAIL_TEST_TO=
